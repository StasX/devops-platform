# Copy to .env in the repository root. Values are literal, not shell expressions.
# Use full-line comments; do not add comments after values.
TF_VAR_aws_region=us-east-1
TF_VAR_project_name=devops-platform
TF_VAR_ssh_key_name=replace-with-your-existing-ec2-key-pair
TF_VAR_admin_cidr=203.0.113.10/32
TF_VAR_root_volume_size=100
# Optional: select an existing AWS CLI profile. Prefer profiles over stored keys.
# AWS_PROFILE=devops

# GCP: used with scripts/terraform.ps1 gcp or scripts/terraform.sh gcp.
TF_VAR_gcp_project_id=replace-with-your-gcp-project-id
TF_VAR_gcp_region=us-central1
TF_VAR_ssh_username=ubuntu
TF_VAR_ssh_public_key_path=~/.ssh/id_ed25519.pub

# Azure: used with scripts/terraform.ps1 azure or scripts/terraform.sh azure.
# Uses the shared project_name, admin_cidr, root_volume_size and SSH inputs above.
TF_VAR_azure_subscription_id=replace-with-your-azure-subscription-id
TF_VAR_azure_location=eastus
# Optional: choose two zones supported by Standard_D4s_v5 in your subscription.
# TF_VAR_azure_zones=["1","2"]

# vSphere: used with scripts/terraform.ps1 vsphere or scripts/terraform.sh vsphere.
# Uses the shared project_name, admin_cidr, root_volume_size and SSH inputs above.
TF_VAR_vsphere_server=vcenter.example.com
TF_VAR_vsphere_datacenter=Datacenter
TF_VAR_vsphere_cluster=Cluster
TF_VAR_vsphere_template=templates/ubuntu-24.04-cloud-init
TF_VAR_vsphere_storage_policy=VM-Encryption-Policy
TF_VAR_vsphere_dns_servers=["10.20.0.1","10.20.1.1"]
TF_VAR_vsphere_nodes={"node-1":{"network":"platform-public-1","datastore":"datastore-1","ipv4_address":"10.20.0.10","ipv4_prefix":24,"ipv4_gateway":"10.20.0.1"},"node-2":{"network":"platform-public-2","datastore":"datastore-2","ipv4_address":"10.20.1.10","ipv4_prefix":24,"ipv4_gateway":"10.20.1.1"}}
# Set credentials in your process environment or local ignored .env only.
# TF_VAR_vsphere_user=terraform@vsphere.local
# TF_VAR_vsphere_password=replace-with-your-password
